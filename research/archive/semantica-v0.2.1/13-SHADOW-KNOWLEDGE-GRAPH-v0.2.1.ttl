# ===== Schema Definition =====

logis:Shipment a owl:Class ;
    rdfs:label "Shipment"@en ;
    rdfs:comment "Core business context for a freight job"@en .

logis:Organization a owl:Class ;
    rdfs:label "Organization"@en .

logis:Person a owl:Class ;
    rdfs:label "Person"@en .

logis:PartyRole a owl:Class ;
    rdfs:label "PartyRole"@en ;
    rdfs:comment "Role played by Organization/Person in a Shipment"@en .

logis:Cargo a owl:Class ;
    rdfs:label "Cargo"@en .

logis:Route a owl:Class ;
    rdfs:label "Route"@en .

logis:RouteLeg a owl:Class ;
    rdfs:label "RouteLeg"@en .

logis:TransportNode a owl:Class ;
    rdfs:label "TransportNode"@en .

logis:BusinessEvent a owl:Class ;
    rdfs:label "BusinessEvent"@en .

logis:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Reality evidence supporting a claim"@en .

logis:RealityClaim a owl:Class ;
    rdfs:label "RealityClaim"@en ;
    rdfs:comment "A validated assertion about reality"@en .

# ===== Object Properties =====

logis:hasPartyRole a owl:ObjectProperty ;
    rdfs:domain logis:Organization ;
    rdfs:range logis:PartyRole .

logis:playsRole a owl:ObjectProperty ;
    rdfs:domain logis:PartyRole ;
    rdfs:range logis:Organization .

logis:hasShipment a owl:ObjectProperty ;
    rdfs:domain logis:PartyRole ;
    rdfs:range logis:Shipment .

logis:hasRoute a owl:ObjectProperty ;
    rdfs:domain logis:Shipment ;
    rdfs:range logis:Route .

logis:hasOrigin a owl:ObjectProperty ;
    rdfs:domain logis:Route ;
    rdfs:range logis:TransportNode .

logis:hasDestination a owl:ObjectProperty ;
    rdfs:domain logis:Route ;
    rdfs:range logis:TransportNode .

logis:hasEvidence a owl:ObjectProperty ;
    rdfs:domain logis:RealityClaim ;
    rdfs:range logis:Evidence .

logis:supportsClaim a owl:ObjectProperty ;
    rdfs:domain logis:Evidence ;
    rdfs:range logis:RealityClaim .

# ===== Data Properties =====

logis:hasShipmentId a owl:DatatypeProperty ;
    rdfs:domain logis:Shipment ;
    rdfs:range xsd:string .

logis:hasClaimId a owl:DatatypeProperty ;
    rdfs:domain logis:RealityClaim ;
    rdfs:range xsd:string .

logis:hasEvidenceId a owl:DatatypeProperty ;
    rdfs:domain logis:Evidence ;
    rdfs:range xsd:string .

logis:hasStatus a owl:DatatypeProperty ;
    rdfs:domain logis:RealityClaim ;
    rdfs:range xsd:string .

