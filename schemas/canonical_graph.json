{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semantica.ai/schemas/canonical_graph/v1.0",
  "title": "Canonical Graph Schema",
  "description": "Semantica canonical graph representation - unified format for all pipelines",
  "type": "object",
  "required": ["version", "entities", "relationships"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^entity_[a-zA-Z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "required": ["source_document_id", "source_revision"],
            "properties": {
              "source_document_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              },
              "text_basis": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "extractor": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "target", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^relationship_[a-zA-Z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Reference to source entity id"
          },
          "target": {
            "type": "string",
            "description": "Reference to target entity id"
          },
          "properties": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "required": ["source_document_id", "source_revision"],
            "properties": {
              "source_document_id": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}