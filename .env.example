# 环境变量模板 —— 复制为 .env 并填入真实值
# ⚠️ .env 不要提交到 Git！

# DeepSeek API (用于 NER/Relation LLM 模式)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI API (用于 Embedding / GPT 模式)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Neo4j 密码 (backend.yaml 中引用 $NEO4J_PASSWORD)
NEO4J_PASSWORD=your_neo4j_password

# 可选：模型选择
LLM_MODEL=deepseek-chat
NER_MODE=pattern          # pattern | llm | hybrid
RELATION_MODE=pattern     # pattern | llm | hybrid